+package com.android.systemui.biometrics
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.PixelFormat
+import android.graphics.Point
+import android.hardware.display.DisplayManager
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import android.os.Parcel
+import android.os.ServiceManager
+import android.util.Log
+import android.view.Display
+import android.view.Gravity
+import android.view.View
+import android.view.WindowManager
+import kotlin.math.pow
+
+private const val TAG = "UdfpsMotoPanelHbm"
+
+private const val PANEL_SERVICE = "com.motorola.hardware.display.panel.IDisplayPanel/default"
+private const val PANEL_DESCRIPTOR = "com.motorola.hardware.display.panel.IDisplayPanel"
+private const val TRANSACTION_SET_MODE = IBinder.FIRST_CALL_TRANSACTION + 4
+private const val PANEL_MODE_NORMAL = 0
+private const val PANEL_MODE_HIGH_BRIGHT_FOD = 4
+
+// Time for the dim layer to reach the screen before HBM, and for HBM to end before it goes.
+private const val DIM_SETTLE_MS = 20L
+
+/**
+ * Local UDFPS illumination for Motorola panels: switches the panel into its HIGH_BRIGHT_FOD mode
+ * through the Moto display panel HAL and covers everything except the sensor with a dim layer, so
+ * only the sensor area gets brighter.
+ */
+class UdfpsMotoPanelHbm(
+    private val context: Context,
+    private val authController: AuthController,
+) {
+    private val res = context.resources
+    private val windowManager = context.getSystemService(WindowManager::class.java)!!
+    private val displayManager = context.getSystemService(DisplayManager::class.java)!!
+    private val handler = Handler(Looper.getMainLooper())
+    private val readyDelayMs =
+        res.getInteger(com.android.systemui.res.R.integer.config_udfpsBoostBrightnessDelayMs)
+            .toLong()
+    private val hbmNits =
+        res.getInteger(com.android.systemui.res.R.integer.config_udfpsMotoPanelHbmNits).toFloat()
+    private val brightnessToNits: List<Pair<Float, Float>> =
+        res.getStringArray(com.android.systemui.res.R.array.config_udfpsMotoPanelBrightnessNits)
+            .map {
+                val (brightness, nits) = it.split(",").map { value -> value.trim().toFloat() }
+                brightness to nits
+            }
+            .sortedBy { it.first }
+
+    private val dimView = DimView(context)
+    private var dimShown = false
+    // Bumped on every enable/disable so a stale frame-commit callback can't turn HBM on.
+    private var generation = 0
+    private val pending = mutableListOf<Runnable>()
+
+    private val dimLayoutParams =
+        WindowManager.LayoutParams(
+                WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL,
+                0,
+                PixelFormat.TRANSLUCENT,
+            )
+            .apply {
+                title = "UDFPS HBM dim layer"
+                fitInsetsTypes = 0
+                gravity = Gravity.TOP or Gravity.LEFT
+                layoutInDisplayCutoutMode =
+                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+                flags =
+                    Utils.FINGERPRINT_OVERLAY_LAYOUT_PARAM_FLAGS or
+                        WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                privateFlags =
+                    WindowManager.LayoutParams.PRIVATE_FLAG_TRUSTED_OVERLAY or
+                        WindowManager.LayoutParams.PRIVATE_FLAG_IS_ROUNDED_CORNERS_OVERLAY
+                accessibilityTitle = " "
+            }
+
+    /** Dims the screen around the sensor, enables panel HBM, then runs [onReady]. */
+    fun enable(onReady: Runnable) {
+        cancelPending()
+        val token = ++generation
+        val location = authController.udfpsLocation
+        val radius = authController.udfpsRadius
+        if (location == null || radius <= 0f) {
+            Log.e(TAG, "enable | no UDFPS location, skipping HBM")
+            onReady.run()
+            return
+        }
+
+        dimView.update(location, radius, dimAlpha())
+        if (!dimShown) {
+            windowManager.addView(dimView, dimLayoutParams)
+            dimShown = true
+        }
+
+        // Turn on HBM only once the dim layer is on screen, so the rest of the display
+        // never flashes bright.
+        dimView.viewTreeObserver.registerFrameCommitCallback {
+            if (token != generation) return@registerFrameCommitCallback
+            schedule(DIM_SETTLE_MS) {
+                if (!setPanelMode(PANEL_MODE_HIGH_BRIGHT_FOD)) {
+                    removeDimLayer()
+                }
+                schedule(readyDelayMs) { onReady.run() }
+            }
+        }
+        dimView.invalidate()
+    }
+
+    /** Leaves panel HBM and removes the dim layer once the panel is back to normal. */
+    fun disable() {
+        cancelPending()
+        generation++
+        setPanelMode(PANEL_MODE_NORMAL)
+        schedule(DIM_SETTLE_MS) { removeDimLayer() }
+    }
+
+    private fun removeDimLayer() {
+        if (dimShown) {
+            windowManager.removeView(dimView)
+            dimShown = false
+        }
+    }
+
+    private fun schedule(delayMs: Long, action: () -> Unit) {
+        val runnable = object : Runnable {
+            override fun run() {
+                pending.remove(this)
+                action()
+            }
+        }
+        pending.add(runnable)
+        handler.postDelayed(runnable, delayMs)
+    }
+
+    private fun cancelPending() {
+        pending.forEach { handler.removeCallbacks(it) }
+        pending.clear()
+    }
+
+    /** Alpha of a black layer that makes HBM look like the current brightness. */
+    private fun dimAlpha(): Float {
+        val brightness =
+            displayManager.getDisplay(Display.DEFAULT_DISPLAY)?.brightnessInfo?.brightness
+                ?: return 0f
+        val currentNits = brightnessToNits(brightness)
+        if (currentNits <= 0f || hbmNits <= 0f || currentNits >= hbmNits) {
+            return 0f
+        }
+        // Black blending happens on gamma-encoded values, luminance follows ~2.2 gamma.
+        return (1f - (currentNits / hbmNits).pow(1f / 2.2f)).coerceIn(0f, 1f)
+    }
+
+    private fun brightnessToNits(brightness: Float): Float {
+        if (brightnessToNits.isEmpty()) return 0f
+        val upper = brightnessToNits.indexOfFirst { it.first >= brightness }
+        if (upper <= 0) {
+            return if (upper == 0) brightnessToNits[0].second else brightnessToNits.last().second
+        }
+        val (b0, n0) = brightnessToNits[upper - 1]
+        val (b1, n1) = brightnessToNits[upper]
+        return n0 + (brightness - b0) * (n1 - n0) / (b1 - b0)
+    }
+
+    private fun setPanelMode(mode: Int): Boolean {
+        val binder = ServiceManager.checkService(PANEL_SERVICE)
+        if (binder == null) {
+            Log.e(TAG, "setPanelMode | $PANEL_SERVICE not found")
+            return false
+        }
+        val data = Parcel.obtain()
+        val reply = Parcel.obtain()
+        return try {
+            data.writeInterfaceToken(PANEL_DESCRIPTOR)
+            data.writeInt(mode)
+            binder.transact(TRANSACTION_SET_MODE, data, reply, 0)
+            reply.readException()
+            val ret = reply.readInt()
+            if (ret != 0) Log.e(TAG, "setPanelMode | mode $mode returned $ret")
+            ret == 0
+        } catch (e: Exception) {
+            Log.e(TAG, "setPanelMode | mode $mode failed", e)
+            false
+        } finally {
+            data.recycle()
+            reply.recycle()
+        }
+    }
+
+    private class DimView(context: Context) : View(context) {
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.BLACK }
+        private val path = Path().apply { fillType = Path.FillType.EVEN_ODD }
+        private var center = Point()
+        private var radius = 0f
+
+        fun update(center: Point, radius: Float, alpha: Float) {
+            this.center = center
+            this.radius = radius
+            paint.alpha = (alpha * 255).toInt()
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            path.reset()
+            path.addRect(0f, 0f, width.toFloat(), height.toFloat(), Path.Direction.CW)
+            path.addCircle(center.x.toFloat(), center.y.toFloat(), radius, Path.Direction.CW)
+            canvas.drawPath(path, paint)
+        }
+    }
+}
